# Tracker service environment. Names only - never commit values.
# Phase 1 requires DATABASE_URL. Everything else has a safe default.

# Postgres connection string for the tracker database.
DATABASE_URL=

# Shared secret for the (Phase 3) server-rendered /admin dashboard.
TRACKER_ADMIN_TOKEN=

# HTTP listen port. Default 8787.
PORT=

# "production" enables JSON logs; anything else keeps them human-readable.
NODE_ENV=

# Comma-separated CORS allowlist. Defaults to winr.fun, raffled.tuttilabs.xyz, localhost:5173.
CORS_ORIGINS=

# Reported verbatim by GET /healthz. Typically the git sha or image tag.
TRACKER_RELEASE=

# Set "true" only when running behind a trusted reverse proxy.
TRUST_PROXY=

# Ingest rate limits (requests per minute).
RATE_LIMIT_PER_IP=
RATE_LIMIT_PER_ANON_PER_MIN=
RATE_LIMIT_GLOBAL_PER_MIN=

# Phase 4 - Discord webhook for alerts.
ALERT_WEBHOOK_URL=

# Phase 4 - retention windows in days (min 30, default 90).
RETENTION_DAYS_EVENTS=
RETENTION_DAYS_ERRORS=
RETENTION_DAYS_PERF=

# Only used by tests. When set, DB-backed integration tests run.
TRACKER_TEST_DATABASE_URL=
